# PENRA Money OS — local environment configuration
#
# Copy this file to `.env.local` and fill in your own Supabase project values.
# `.env.local` is git-ignored and must never be committed.
#
# These are PUBLIC, browser-exposed values (Next.js inlines any NEXT_PUBLIC_*
# variable into the client bundle at build time). Only put the Supabase
# project URL and PUBLISHABLE key here — never a secret / service-role key.
#
# See docs/phase-1/02-local-development.md and
# docs/phase-1/03-supabase-foundation.md for setup instructions.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only canonical application URL. Used to build safe, absolute
# redirect URLs for Supabase auth emails (signup confirmation, password
# recovery) instead of trusting request headers. Never exposed to the
# browser (no NEXT_PUBLIC_ prefix). Must be an absolute http(s) URL with no
# trailing slash.
APP_URL=http://localhost:3000

# Phase 8 market data — stock-price provider credential (Twelve Data).
#
# NOT a Next.js environment variable and NOT read from .env.local — the
# browser and the Next.js server never see this key. It is an Edge Function
# secret consumed only by supabase/functions/stock-price-refresh (via
# Deno.env.get), set with:
#   supabase secrets set TWELVE_DATA_API_KEY=<your key> --project-ref <ref>
# Listed here only so the required variable name is documented in one
# place. Left unset in this environment: stock-price refresh runs its
# fully-implemented "provider not configured" path (skips cleanly, leaves
# manual valuations untouched) until an operator sets this secret. AMFI
# mutual-fund NAV refresh needs no credential and is unaffected either way.
# TWELVE_DATA_API_KEY=
