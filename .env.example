# PENRA Money OS — local environment configuration
#
# Copy this file to `.env.local` and fill in your own Supabase project values.
# `.env.local` is git-ignored and must never be committed.
#
# These are PUBLIC, browser-exposed values (Next.js inlines any NEXT_PUBLIC_*
# variable into the client bundle at build time). Only put the Supabase
# project URL and PUBLISHABLE key here — never a secret / service-role key.
#
# See docs/phase-1/02-local-development.md and
# docs/phase-1/03-supabase-foundation.md for setup instructions.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only canonical application URL. Used to build safe, absolute
# redirect URLs for Supabase auth emails (signup confirmation, password
# recovery) instead of trusting request headers. Never exposed to the
# browser (no NEXT_PUBLIC_ prefix). Must be an absolute http(s) URL with no
# trailing slash.
APP_URL=http://localhost:3000
