{
  "name": "penra-money-os",
  "version": "0.1.0",
  "private": true,
  "description": "PENRA Money OS — a private personal money operating system. Phase 1 engineering foundation.",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-coverage": "type-coverage --strict --at-least 99.9 --ignore-files \".next/**\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "supabase:init": "supabase init",
    "db:types:local": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:types:linked": "supabase gen types typescript --linked > src/types/database.types.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "^0.545.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "20.19.43",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10",
    "jsdom": "^29",
    "prettier": "^3",
    "supabase": "2.114.0",
    "tailwindcss": "^4",
    "type-coverage": "^2.30.1",
    "typescript": "^5",
    "typescript-eslint": "8.67.0",
    "vitest": "^4"
  }
}
